{
    "functions": {
        "source": "functions",
        "runtime": "nodejs20"
    },
    "database": {
        "rules": "database.rules.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/app",
                "destination": "/app.html"
            },
            {
                "source": "/admin",
                "destination": "/admin_panel.html"
            },
            {
                "source": "/terms",
                "destination": "/terms.html"
            },
            {
                "source": "/privacy",
                "destination": "/privacy.html"
            },
            {
                "source": "/refund",
                "destination": "/refund.html"
            },
            {
                "source": "/contact",
                "destination": "/contact.html"
            },
            {
                "source": "/payment-callback",
                "destination": "/payment-callback.html"
            },
            {
                "source": "/download",
                "destination": "/jeetoplay.apk"
            },
            {
                "source": "/api/create_payment",
                "function": "createPaymentApi"
            },
            {
                "source": "/api/zapupi_auto_check",
                "function": "zapupiAutoCheckApi"
            },
            {
                "source": "/api/check_payment_status",
                "function": "checkPaymentStatusApi"
            },
            {
                "source": "/api/webhook",
                "function": "webhookApi"
            },
            {
                "source": "/webhook",
                "function": "webhookApi"
            }
        ],
        "headers": [
            {
                "source": "**",
                "headers": [
                    {
                        "key": "X-Content-Type-Options",
                        "value": "nosniff"
                    },
                    {
                        "key": "X-Frame-Options",
                        "value": "SAMEORIGIN"
                    }
                ]
            },
            {
                "source": "**/*.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=604800, immutable"
                    }
                ]
            },
            {
                "source": "assets/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            },
            {
                "source": "**/*.apk",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/vnd.android.package-archive"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            }
        ]
    }
}